# Wallet
PRIVATE_KEY=

# Connection
RPC_ENDPOINT=https://api.mainnet-beta.solana.com
RPC_WEBSOCKET_ENDPOINT=wss://api.mainnet-beta.solana.com
COMMITMENT_LEVEL=confirmed

# Bot
LOG_LEVEL=trace
MAX_TOKENS_AT_THE_TIME=1
PRE_LOAD_EXISTING_MARKETS=false
CACHE_NEW_MARKETS=false
# default or warp or jito
TRANSACTION_EXECUTOR=default
# if using default executor, fee below will be applied
COMPUTE_UNIT_LIMIT=101337
COMPUTE_UNIT_PRICE=421197
# if using warp or jito executor, fee below will be applied
CUSTOM_FEE=0.006

# ---- Dynamic priority fees (default executor) ----
# picks the PRIORITY_FEE_PERCENTILE percentile of recent network fees, clamped to MIN/MAX
DYNAMIC_PRIORITY_FEES=true
PRIORITY_FEE_PERCENTILE=90
MIN_PRIORITY_FEE=50000
MAX_PRIORITY_FEE=2000000

# ---- Jito ----
# tip is embedded inside the swap tx (single-tx bundle, jito best practice)
JITO_DYNAMIC_TIP=true
JITO_TIP_PERCENTILE=75
MIN_JITO_TIP_SOL=0.0001
MAX_JITO_TIP_SOL=0.01

# ---- Routing (Jupiter Swap API V2 aggregator: Raydium AMM/CPMM/CLMM, Orca, Meteora, Pump.fun, ...) ----
JUPITER_API_URL=https://api.jup.ag/swap/v2
# optional api key from developers.jup.ag (higher rate limits)
JUPITER_API_KEY=
# auto: raydium direct first + jupiter fallback | jupiter: always aggregate | raydium: direct only
BUY_EXECUTION=auto
SELL_EXECUTION=auto
JUPITER_MAX_ACCOUNTS=64
# comma-separated DEX labels to exclude from jupiter routing (e.g. HumidiFi)
JUPITER_EXCLUDE_DEXES=

# ---- Buy ----
# WSOL / USDC / SOL (SOL = native: WSOL account is auto-created and SOL is
# wrapped atomically for Raydium trades, Jupiter swaps use native SOL directly)
QUOTE_MINT=WSOL
# fixed: spend QUOTE_AMOUNT every trade | percent: spend QUOTE_AMOUNT_PERCENT % of wallet balance
QUOTE_AMOUNT_MODE=fixed
QUOTE_AMOUNT_PERCENT=50
# reserve kept for fees when using percent mode with WSOL/SOL
MIN_SOL_BUFFER=0.01
QUOTE_AMOUNT=0.001
AUTO_BUY_DELAY=0
MAX_BUY_RETRIES=10
BUY_SLIPPAGE=20

# ---- Sell ----
AUTO_SELL=true
MAX_SELL_RETRIES=10
AUTO_SELL_DELAY=0
PRICE_CHECK_INTERVAL=2000
PRICE_CHECK_DURATION=600000
TAKE_PROFIT=40
STOP_LOSS=20
TRAILING_STOP_LOSS=true
SKIP_SELLING_IF_LOST_MORE_THAN=90
SELL_SLIPPAGE=20

# ---- Rug pull protection ----
# monitors pool quote-vault liquidity; on a sharp drain (> LIQUIDITY_DROP_PCT %) emergency-sells
RUG_PULL_PROTECTION=true
LIQUIDITY_DROP_PCT=35
LIQUIDITY_CHECK_INTERVAL=3000
LIQUIDITY_CHECK_DURATION=180000
# slippage used for emergency rug sells (get out at almost any price)
RUG_SLIPPAGE=49

# ---- Buy the dip (averaging down) ----
BUY_THE_DIP=false
# trigger when price is this % below entry
DIP_TRIGGER_PCT=25
DIP_MAX_BUYS=2
DIP_COOLDOWN_MS=60000
# each dip buy amount = QUOTE_AMOUNT * multiplier^dip_number
DIP_AMOUNT_MULTIPLIER=1

# ---- Deep analysis filters ----
# RugCheck.xyz token risk report (score, LP lock, critical risks)
RUG_CHECK=false
RUGCHECK_MAX_SCORE=5000
RUGCHECK_MIN_LP_LOCKED=0
RUGCHECK_FAIL_ON_CRITICAL=true
# reject tokens where one wallet holds more than MAX_TOP_HOLDER_PCT % of supply
CHECK_TOP_HOLDERS=false
MAX_TOP_HOLDER_PCT=35
TOP_HOLDERS_TO_CHECK=10

# ---- Snipe list ----
USE_SNIPE_LIST=false
SNIPE_LIST_REFRESH_INTERVAL=30000

# ---- Pump.fun launch sniping (real-time, routed via Jupiter) ----
# WARNING: needs a dedicated RPC plan (Helius free / public RPC block pump.fun
# program subscriptions — launches will be missed). Keep OFF for free plans.
SNIPE_PUMP_FUN=false
# require at least this much virtual SOL in the curve at launch (0 = off)
PUMP_MIN_INITIAL_SOL=0
PUMP_AUTO_BUY_DELAY=0

# ---- Momentum scanner (recommended on free RPC) ----
# polls the Jupiter Token API over HTTPS (no websockets) and buys fresh tokens
# with 5-minute momentum, healthy liquidity and clean audit flags
SCANNER_MODE=false
SCANNER_POLL_INTERVAL=10000
SCANNER_MIN_LIQUIDITY_USD=5000
SCANNER_MIN_MOMENTUM_5M=10
SCANNER_MIN_HOLDERS=30
SCANNER_MAX_DEV_PCT=10
SCANNER_MAX_TOKEN_AGE_MIN=0

# ---- Original filters ----
FILTER_CHECK_DURATION=60000
FILTER_CHECK_INTERVAL=2000
CONSECUTIVE_FILTER_MATCHES=3
CHECK_IF_MUTABLE=false
CHECK_IF_SOCIALS=true
CHECK_IF_MINT_IS_RENOUNCED=true
CHECK_IF_FREEZABLE=false
CHECK_IF_BURNED=true
MIN_POOL_SIZE=5
MAX_POOL_SIZE=50

# ---- Dashboard ----
DASHBOARD_ENABLED=true
DASHBOARD_PORT=3000

# ---- Stats ----
# trade journal with P&L tracking
STATS_FILE=stats.json
